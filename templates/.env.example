SNOWLUMA_IMAGE=motricseven7/snowluma:latest
SNOWLUMA_CONTAINER=snowluma
SNOWLUMA_UID=1000
SNOWLUMA_GID=1000
SNOWLUMA_WEBUI_HOST=0.0.0.0
SNOWLUMA_WEBUI_PORT=5099
SNOWLUMA_WEBUI_HOST_PORT=5099
SNOWLUMA_LOG_LEVEL=info
SNOWLUMA_SCREEN=1920x1080x24
SNOWLUMA_HOOK_AUTOLOAD=1
SNOWLUMA_ONEBOT_HOST=0.0.0.0
NOVNC_PORT=6081
ONEBOT_HTTP_PORT=3000
ONEBOT_WS_PORT=3001
# Sidecar only: existing compose network to join (do not recreate).
SNOWLUMA_BOT_NETWORK=maim_bot
SNOWLUMA_VOLUME_PREFIX=snowluma
# Leave empty to generate a per-volume remote desktop password on first start.
# VNC_PASSWD=
